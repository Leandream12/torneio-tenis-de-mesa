# SHA-256 hexadecimal da chave privada do organizador.
# Gere a partir de uma chave forte e configure somente no Vercel.
ORGANIZER_SETUP_HASH=

# Redis/Upstash conectado ao projeto no Vercel.
# A integração normalmente fornece um destes pares automaticamente.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternativas aceitas pelo código:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Opcional: permite usar uma chave Redis diferente por ambiente.
TOURNAMENT_STATE_KEY=arena-solar:tournament
